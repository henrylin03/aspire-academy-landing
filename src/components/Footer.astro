---
import { Image } from "astro:assets";
import logo from "@images/logo-with-text-grey.png";
---

<footer
  class="footer sm:footer-horizontal bg-neutral text-neutral-content p-10"
>
  <aside class="mx-auto max-w-md gap-4">
    <a
      href="/"
      aria-label="Return to Aspire Academy debating's home page"
      class="mx-auto sm:mx-0"
      ><Image
        src={logo}
        alt="Logo for Aspire Academy by Huaxia"
        class="w-3xs"
      /></a
    >
    <p class="opacity-60">
      Aspire Academy is a Sydney-based public speaking academy, offering online
      debating, public speaking and leadership classes for NSW school students,
      Year 3 and above.
    </p>
  </aside>
  <section class="m-auto">
    <a class="btn btn-secondary" href="/enrol" role="button">
      Enrol now<svg
        xmlns="http://www.w3.org/2000/svg"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
        class="icon icon-tabler icons-tabler-outline icon-tabler-arrow-right h-4 w-4"
        ><path stroke="none" d="M0 0h24v24H0z" fill="none"></path><path
          d="M5 12l14 0"></path><path d="M13 18l6 -6"></path><path d="M13 6l6 6"
        ></path></svg
      >
    </a>
  </section>
</footer>

<footer
  class="footer footer-horizontal text-neutral-content bg-neutral p-4 opacity-95"
>
  <aside class="mx-auto flex flex-row items-center opacity-70">
    <svg
      xmlns="http://www.w3.org/2000/svg"
      width="16"
      height="16"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
      stroke-linejoin="round"
      class="icon icon-tabler icons-tabler-outline icon-tabler-copyright"
      ><path stroke="none" d="M0 0h24v24H0z" fill="none"></path><path
        d="M3 12a9 9 0 1 0 18 0a9 9 0 1 0 -18 0"></path><path
        d="M14 9.75a3.016 3.016 0 0 0 -4.163 .173a2.993 2.993 0 0 0 0 4.154a3.016 3.016 0 0 0 4.163 .173"
      ></path></svg
    >
    <p class="text-xs">
      Copyright {new Date().getFullYear()} Aspire Academy
    </p>
  </aside>
</footer>
