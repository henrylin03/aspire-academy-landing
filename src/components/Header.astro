---
import logo from "@images/logo-with-text.png";
import { Image } from "astro:assets";
---

<header class="navbar bg-white pr-10 shadow-sm">
  <div class="navbar-start">
    <a href="/" class="flex items-center" aria-label="return to home page"
      ><Image
        src={logo}
        loading="eager"
        alt="Logo for Aspire Academy"
        class="w-52 px-1 py-2"
      /></a
    >
  </div>
  <div class="navbar-end">
    <a class="btn btn-secondary" href="/enrol" role="button">
      <span>Enrol now</span><svg
        xmlns="http://www.w3.org/2000/svg"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
        class="icon icon-tabler icons-tabler-outline icon-tabler-arrow-right h-4 w-4 lg:h-6 lg:w-6"
        ><path stroke="none" d="M0 0h24v24H0z" fill="none"></path><path
          d="M5 12l14 0"></path><path d="M13 18l6 -6"></path><path d="M13 6l6 6"
        ></path></svg
      >
    </a>
  </div>
</header>
