---
/* eslint-disable astro/no-set-html-directive */
interface Props {
  title: string;
  description: string;
  icon: string;
}
const { title, description, icon } = Astro.props;
---

<article
  class="flex flex-col gap-6 rounded-2xl bg-white p-6 shadow-md lg:gap-8 lg:p-8"
>
  <div class="flex flex-1 flex-col gap-2">
    <figure
      class="mask bg-secondary mb-3 h-auto w-12 rounded-xl p-3 text-white opacity-80"
    >
      <Fragment set:html={icon} />
    </figure>
    <h3 class="text-2xl font-bold tracking-wide">
      {title}
    </h3>
    <p class="text-sm opacity-80 md:text-base">
      {description}
    </p>
  </div>
  <slot />
</article>
