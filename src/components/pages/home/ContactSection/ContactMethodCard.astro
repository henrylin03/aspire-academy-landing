---
/* eslint-disable astro/no-set-html-directive */
interface Props {
  title: string;
  description: string;
  icon: string;
}
const { title, description, icon } = Astro.props;
---

<article class="flex flex-col gap-4 rounded-2xl bg-white p-6 shadow-md lg:p-8">
  <div class="flex flex-1 flex-col gap-2 lg:gap-4">
    <figure
      class="mask bg-secondary h-auto w-12 rounded-xl p-3 text-white opacity-80"
    >
      <Fragment set:html={icon} />
    </figure>
    <h3 class="text-lg font-bold tracking-wide lg:text-2xl">
      {title}
    </h3>
    <p class="text-sm opacity-80 md:text-base">
      {description}
    </p>
  </div>
  <slot />
</article>
