---
import SectionHeading from "@/components/shared/SectionHeading.astro";
import { CONTACT_DETAILS } from "@/data/contactDetails";

const CONTACT_DATA = [
  {
    type: "Email support",
    value: CONTACT_DETAILS.email,
    icon: `<svg
        xmlns="http://www.w3.org/2000/svg"
        width="24"
        height="24"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
        class="icon icon-tabler icons-tabler-outline icon-tabler-mail"
      >
        <path stroke="none" d="M0 0h24v24H0z" fill="none" />
        <path d="M3 7a2 2 0 0 1 2 -2h14a2 2 0 0 1 2 2v10a2 2 0 0 1 -2 2h-14a2 2 0 0 1 -2 -2v-10" />
        <path d="M3 7l9 6l9 -6" />
      </svg>`,
    description: "Our team will respond to you as soon as possible.",
  },
  {
    type: "Call/SMS us",
    value: CONTACT_DETAILS.phone,
    icon: `<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="icon icon-tabler icons-tabler-outline icon-tabler-phone"><path stroke="none" d="M0 0h24v24H0z" fill="none" /><path d="M5 4h4l2 5l-2.5 1.5a11 11 0 0 0 5 5l1.5 -2.5l5 2v4a2 2 0 0 1 -2 2a16 16 0 0 1 -15 -15a2 2 0 0 1 2 -2" /></svg>`,
    description: "Available during working hours (9am-5pm everyday).",
  },
  {
    type: "WeChat 微信",
    value: `Search: ${CONTACT_DETAILS.weChat}`,
    icon: `<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="icon icon-tabler icons-tabler-outline icon-tabler-brand-wechat">
	<path stroke="none" d="M0 0h24v24H0z" fill="none" />
	<path d="M16.5 10c3.038 0 5.5 2.015 5.5 4.5c0 1.397 -.778 2.645 -2 3.47l0 2.03l-1.964 -1.178a6.649 6.649 0 0 1 -1.536 .178c-3.038 0 -5.5 -2.015 -5.5 -4.5s2.462 -4.5 5.5 -4.5" />
	<path d="M11.197 15.698c-.69 .196 -1.43 .302 -2.197 .302a8.008 8.008 0 0 1 -2.612 -.432l-2.388 1.432v-2.801c-1.237 -1.082 -2 -2.564 -2 -4.199c0 -3.314 3.134 -6 7 -6c3.782 0 6.863 2.57 7 5.785l0 .233" />
	<path d="M10 8h.01" />
	<path d="M7 8h.01" />
	<path d="M15 14h.01" />
	<path d="M18 14h.01" />
</svg>`,
    description: "Mandarin Chinese support is available.",
  },
];
---

<section class="px-6 py-24 sm:px-12 lg:p-24">
  <div class="mx-auto flex max-w-7xl flex-col gap-20">
    <div class="flex flex-col gap-2 text-center">
      <SectionHeading text="We'd love to hear from you" subtext="Contact us" />
      <p class="text-sm opacity-80 md:text-base">
        Our friendly team is available to answer your questions.
      </p>
    </div>
    <div class="grid grid-cols-3 gap-6">
      {
        CONTACT_DATA.map((contactMethod) => (
          <article class="flex flex-col gap-8 text-left">
            <div class="flex flex-1 flex-col gap-2">
              <figure class="mask bg-secondary mb-3 h-auto w-12 rounded-xl p-3 text-white opacity-80">
                {/* eslint-disable-next-line astro/no-set-html-directive */}
                <Fragment set:html={contactMethod.icon} />
              </figure>
              <h3 class="text-2xl font-bold tracking-wide capitalize">
                {contactMethod.type}
              </h3>
              <p class="text-sm opacity-80 md:text-base">
                {contactMethod.description}
              </p>
            </div>
            <p class="text-secondary text-xs font-bold md:text-sm">
              {contactMethod.value}
            </p>
          </article>
        ))
      }
    </div>
  </div>
</section>
