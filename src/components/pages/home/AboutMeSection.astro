---
import SectionHeading from "@/components/shared/SectionHeading.astro";
import profileImg from "@images/henry/headshot.jpg";
import hostImg from "@images/henry/host.jpg";
import mootingImg from "@images/henry/mooting.jpg";
import { Image } from "astro:assets";
---

<section class="px-6 pb-24 sm:px-12 lg:p-24">
  <div
    class="border-base-300 mx-auto grid max-w-7xl items-center justify-items-center gap-12 rounded-2xl border bg-white p-8 shadow-lg sm:p-12 lg:grid-cols-[1.5fr_1fr] lg:p-16"
  >
    <div>
      <SectionHeading text="Who is the coach?" subtext="About" />
      <div class="mt-4 flex flex-col gap-4 text-sm opacity-90 md:text-base">
        <p>Hi, I'm Henry - lovely to meet you all!</p>
        <p>
          I started debating in primary school and represented my school in the
          NSW Premier's Debating Challenge (PDC). After graduating, I coached
          and adjudicated public speaking and debating for over 5 years,
          including at selective schools like North Sydney Boys and North Sydney
          Girls, and private schools that compete in ISDA, GPS and Eastside
          competitions.
        </p>
        <p>
          I started Aspire Academy to share the skills I gained over the years
          in debating. Debating helped give me confidence, structured way of
          thinking and public speaking skills - things I want to give to all of
          my students to help everyone perform better academically, and become
          more articulate and confident.
        </p>
      </div>
    </div>
    <div class="hidden grid-cols-[1.5fr_1fr] items-center gap-4 lg:grid">
      <Image
        src={profileImg}
        alt="Henry is the founder and head debating coach for Aspire Academy"
        loading="lazy"
        class="mask z-99 mask-circle shadow-xl"
      />
      <div class="flex translate-y-4 flex-col gap-4">
        <Image
          src={hostImg}
          alt="Henry has years of experience teaching and adjudicating debating competitions across Greater Sydney"
          class="w-40 rounded-md shadow-xl"
        />
        <Image
          src={mootingImg}
          alt="Throughout high school, Henry participated in competitive debating and has years of experience in debating and public speaking"
          class="w-48 -translate-x-20 translate-y-1/16 place-self-end rounded-md shadow-xl"
        />
      </div>
    </div>
    <Image
      src={profileImg}
      alt="Henry is the founder and head debating coach for Aspire Academy"
      loading="lazy"
      class="mask w-3xs mask-circle shadow-xl lg:hidden"
    />
  </div>
</section>
